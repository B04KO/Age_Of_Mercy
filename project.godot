config_version=5

[application]

config/name="Age of Mercy"
run/main_scene="res://Level1/diolog_king.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
boot_splash/image="/home/admin/Загрузки/Picsart_24-12-03_09-33-46-032.png"

[display]

